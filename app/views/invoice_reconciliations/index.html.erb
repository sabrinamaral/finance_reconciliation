<div class="my-3">
  <% if @periods.any? %>
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
      <div class="d-flex flex-wrap align-items-center gap-2">
        <label class="fw-semibold text-secondary" style="font-size:0.85em;">Period:</label>
        <%= select_tag :period_id,
              options_for_select(
                @periods.map { |p| [p.label, invoice_reconciliations_path(period_id: p.id)] },
                invoice_reconciliations_path(period_id: @period.id)
              ),
              class: "form-select form-select-sm",
              style: "width: auto",
              onchange: "window.location.href = this.value" %>
      </div>

      <div class="dropdown">
        <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
          Actions
        </button>
        <ul class="dropdown-menu dropdown-menu-end">

          <li class="dropdown-submenu" data-controller="dropdown-submenu">
            <a class="dropdown-item dropdown-toggle-submenu" href="#" data-action="click->dropdown-submenu#toggle">
              Download PDF
            </a>
            <ul class="dropdown-menu submenu" data-dropdown-submenu-target="menu">
              <li><%= link_to "All", download_pdf_invoice_reconciliations_path(period_id: @period.id, scope: "all"), class: "dropdown-item", target: "_blank", rel: "noopener noreferrer" %></li>
              <li><%= link_to "Reconciled", download_pdf_invoice_reconciliations_path(period_id: @period.id, scope: "reconciled"), class: "dropdown-item", target: "_blank", rel: "noopener noreferrer" %></li>
              <li><%= link_to "Unreconciled", download_pdf_invoice_reconciliations_path(period_id: @period.id, scope: "unreconciled"), class: "dropdown-item", target: "_blank", rel: "noopener noreferrer" %></li>
            </ul>
          </li>

          <li class="dropdown-submenu" data-controller="dropdown-submenu">
            <a class="dropdown-item dropdown-toggle-submenu" href="#" data-action="click->dropdown-submenu#toggle">
              Download Excel
            </a>
            <ul class="dropdown-menu submenu" data-dropdown-submenu-target="menu">
              <li><%= link_to "All", download_excel_invoice_reconciliations_path(period_id: @period.id, format: :xlsx, scope: "all"), class: "dropdown-item" %></li>
              <li><%= link_to "Reconciled", download_excel_invoice_reconciliations_path(period_id: @period.id, format: :xlsx, scope: "reconciled"), class: "dropdown-item" %></li>
              <li><%= link_to "Unreconciled", download_excel_invoice_reconciliations_path(period_id: @period.id, format: :xlsx, scope: "unreconciled"), class: "dropdown-item" %></li>
            </ul>
          </li>

          <li><hr class="dropdown-divider"></li>
          <li>
            <%= button_to "Delete All Invoices",
                          { action: "delete_all", period_id: @period.id },
                          method: :delete,
                          form: { data: { turbo_confirm: "This will permanently delete all invoices for #{@period.label}. Are you sure?" } },
                          class: "dropdown-item text-danger" %>
          </li>
        </ul>
      </div>
    </div>
  <% end %>

  <%= form_with url: invoice_reconciliations_path(period_id: @period.id),
                local: true, multipart: true do |form| %>
    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
      <%= form.file_field :file, class: 'form-control' %>
      <%= form.submit 'Upload Invoices', class: 'btn btn-primary text-nowrap' %>
    </div>
  <% end %>
</div>

<% if @bank_records.present? %>
  <%= render partial: 'tables' %>
<% else %>
  <p>No bank records found for this period. Upload the bank statement in Bank Statement first.</p>
<% end %>
